# ========================================
# LARAVEL 11 - CPANEL SHARED HOSTING
# SOLUCIÓN SIN MOD_REWRITE
# ========================================
# Servidor: /public_html/gestion/CEOGestion/
# Alternativas: DirectoryIndex + PHP-based routing
# ========================================

# Si mod_rewrite está disponible, usarlo
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /gestion/CEOGestion/
    
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    RewriteCond %{REQUEST_URI} !^/gestion/CEOGestion/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# ALTERNATIVA: Si mod_rewrite no funciona, usar DirectoryIndex
# Esto sirve de fallback para directorios que no existen
<IfModule !mod_rewrite.c>
    DirectoryIndex index.php
</IfModule>

# ========================================
# SEGURIDAD - Denegar acceso a archivos sensibles
# ========================================
<FilesMatch "\.(env|example|md|lock|json|xml|yaml|yml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Denegar acceso a directorios sensibles
<DirectoryMatch "(^|/)(\.|\w+\.git|artisan|composer|storage|vendor|node_modules|bootstrap)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</DirectoryMatch>

# ========================================
# OPTIMIZACION - GZIP COMPRESSION
# ========================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# ========================================
# CACHE HEADERS
# ========================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
