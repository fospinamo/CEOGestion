# Denegar acceso a archivos sensibles
<FilesMatch "\.(env|example|md|lock|json|xml|yaml|yml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Denegar acceso a directorios
<DirectoryMatch "(^|/)(\.|\w+\.git|artisan|composer|storage|vendor|node_modules|bootstrap)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</DirectoryMatch>

# Redirigir a HTTPS
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
